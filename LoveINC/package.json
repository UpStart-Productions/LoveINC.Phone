{
  "name": "LoveINC",
  "version": "0.0.1",
  "author": "Ionic Framework",
  "homepage": "https://ionicframework.com/",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "cap:sync": "ng build && npx cap sync",
    "cap:run:ios": "ng build && npx cap sync && npx cap run ios",
    "cap:pod:install": "cd ios/App && pod install",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "build:goal-tracker": "ng-packagr -p packages/goal-tracker/ng-package.json && node packages/goal-tracker/scripts/fix-dist-package.js",
    "build:simple-budget": "ng-packagr -p packages/simple-budget/ng-package.json && node packages/simple-budget/scripts/fix-dist-package.js",
    "build:verse-of-the-day": "ng-packagr -p packages/verse-of-the-day/ng-package.json && node packages/verse-of-the-day/scripts/fix-dist-package.js",
    "build:service-unlock": "ng-packagr -p packages/service-unlock/ng-package.json && node packages/service-unlock/scripts/fix-dist-package.js",
    "build:journal": "ng-packagr -p packages/journal/ng-package.json && node packages/journal/scripts/fix-dist-package.js",
    "cap:run:ios:live": "ng build && npx ionic cap run ios -l --external",
    "cap:test:ios": "ng build && npx cap sync && npx cap run ios",
    "increment-ios-build": "node scripts/increment-ios-build.js",
    "version:patch": "node scripts/bump-version.js patch",
    "version:minor": "node scripts/bump-version.js minor",
    "version:major": "node scripts/bump-version.js major",
    "version:build": "node scripts/bump-version.js build",
    "version:sync-ios": "node scripts/sync-ios-from-app-version.js",
    "setup:git-hooks": "node scripts/setup-git-hooks.js",
    "ship:ios": "node scripts/ship-ios-app-store.js",
    "ship:ios:build": "node scripts/ship-ios-app-store.js build",
    "ship:ios:minor": "node scripts/ship-ios-app-store.js minor",
    "ship:ios:major": "node scripts/ship-ios-app-store.js major",
    "postinstall": "patch-package"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.0.0",
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/forms": "^20.0.0",
    "@angular/platform-browser": "^20.0.0",
    "@angular/platform-browser-dynamic": "^20.0.0",
    "@angular/router": "^20.0.0",
    "@capacitor-community/file-opener": "^8.0.0",
    "@capacitor-community/in-app-review": "^8.0.0",
