    "@upstart-productions/goal-tracker": "file:packages/goal-tracker",
    "@upstart-productions/journal": "file:packages/journal",
    "@upstart-productions/service-unlock": "file:packages/service-unlock",
    "@upstart-productions/simple-budget": "file:packages/simple-budget",
    "@upstart-productions/verse-of-the-day": "^2.0.2",
    "capacitor-email-composer": "^8.0.0",
    "date-fns": "^4.1.0",
    "html-to-pdfmake": "^2.5.33",
    "ionicons": "^7.0.0",
    "jeep-sqlite": "^2.8.0",
    "lucide-angular": "^0.563.0",
    "ngx-quill": "^28.0.2",
    "pdfmake": "^0.2.20",
    "quill": "^2.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.0.0",
    "@angular-eslint/builder": "^20.0.0",
